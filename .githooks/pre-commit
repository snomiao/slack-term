#!/usr/bin/env bash
# Block a commit that would put real workspace data into this public repo.
#
# This repo is published (GitHub + npm), and its test fixtures come from real
# Slack recordings — so real colleague names, workspace subdomains and channel
# IDs have leaked in before. Anything that identifies a real person or workspace
# belongs in a placeholder: alice/bob, acme.slack.com, C00000001/U00000001.
#
# The name/workspace denylist lives in .githooks/denylist.sha256 as SHA-256
# hashes, never plaintext — a public repo must not spell out the very names it
# is protecting, and a plaintext list would also be rewritten by any future
# history scrub (which would silently invert what this hook blocks).
#
# Install:  git config core.hooksPath .githooks   (bun install does this for you)
# Check:    bun run scan-pii
# Bypass:   git commit --no-verify                (only for a false positive)

set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DENYLIST="$HOOK_DIR/denylist.sha256"

# Scan staged content only — what is actually about to be committed.
# Lockfiles are excluded: their base64 integrity hashes contain random runs that
# read as Slack IDs, and they hold no workspace data.
staged=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -vE '(^|/)(bun\.lock|bun\.lockb|package-lock\.json|yarn\.lock|pnpm-lock\.yaml|Cargo\.lock)$')
[ -z "$staged" ] && exit 0

# One staged diff, reused by every check below. -I skips binary files.
diff_of_staged() {
  # shellcheck disable=SC2086
  git diff --cached -U0 -I --diff-filter=ACMR -- $staged
}

fail=0
report() {
  if [ "$fail" -eq 0 ]; then
    echo "pre-commit: refusing to commit real workspace data" >&2
    echo >&2
  fi
  fail=1
  echo "  $1" >&2
}

# --- 1. Credentials -------------------------------------------------------
# Safe to spell out: these are format patterns, not anyone's data.
patterns=(
  'xox[abposr]-[A-Za-z0-9]{12,}|looks like a real Slack token'
  'xoxd-[A-Za-z0-9%+/=_-]{20,}|looks like a real session cookie'
)
for entry in "${patterns[@]}"; do
  pat="${entry%%|*}"
  why="${entry#*|}"
  hits=$(diff_of_staged | grep -nE "^\+.*($pat)" | head -5) || true
  if [ -n "$hits" ]; then
    report "$why — matched /$pat/:"
    echo "$hits" | sed 's/^/      /' >&2
  fi
done

# --- 2. Denylisted names / workspaces (hash comparison) -------------------
# Every candidate term in the added lines is hashed and looked up. Candidates:
# whole dotted handles, alphabetic runs (so a bare surname is still found inside
# a longer dotted handle), and CJK 2/3-grams (so a kanji surname is found inside
# a longer run of Japanese text).
if [ -f "$DENYLIST" ]; then
  deny_hits=$(diff_of_staged | grep -E '^\+' | python3 -c '
import hashlib, re, sys
deny = set()
with open(sys.argv[1], encoding="utf-8") as fh:
    for line in fh:
        line = line.strip()
        if line and not line.startswith("#"):
            deny.add(line)
text = sys.stdin.read()
cands = set()
cands.update(w.lower() for w in re.findall(r"[A-Za-z][A-Za-z0-9._-]{3,}", text))
cands.update(w.lower() for w in re.findall(r"[A-Za-z]{4,}", text))
for run in re.findall(r"[぀-ヿ一-鿿]+", text):
    for n in (2, 3):
        for i in range(len(run) - n + 1):
            cands.add(run[i : i + n])
hits = sorted(c for c in cands if hashlib.sha256(c.encode("utf-8")).hexdigest() in deny)
print("\n".join(hits[:5]))
' "$DENYLIST" 2>/dev/null) || true
  if [ -n "$deny_hits" ]; then
    report "denylisted real name / workspace / channel (see .githooks/denylist.sha256):"
    echo "$deny_hits" | sed 's/^/      /' >&2
  fi
fi

# --- 3. Slack IDs ---------------------------------------------------------
# A real Slack ID is a type letter + 8-plus chars of [A-Z0-9] whose TAIL mixes
# letters AND digits. Testing the tail matters: the leading "C" of C00000001
# would otherwise count as the letter and every placeholder would read as real.
# That mix is what separates a real ID from:
#   - all-digit placeholders   — C00000001, T99999999, C0123456789
#   - all-letter English words — CONNECTION, DEFAULT, UPLOADING
# A run of 0000 also marks an ID as a placeholder (F00000LIST, U0000OTHER).
id_pattern='(^|[^A-Za-z0-9_])[CDGUWTBF][A-Z0-9]{8,}'
looks_like_real_id() {
  grep -oE '[CDGUWTBF][A-Z0-9]{8,}' \
    | grep -E '^[CDGUWTBF][A-Z0-9]*[A-Z]' \
    | grep -E '^[CDGUWTBF][A-Z0-9]*[0-9]' \
    | grep -vE '0000' \
    | grep -vE 'EXAMPLE|FAKE|TEST|GUEST|ALICE|BOB|REG|OTHER|YAMADA|SUZUKI|KOBAYASHI|TANAKA|SATO|KENJI|DAVE|BOT|MIX|TARO'
}

id_hits=$(diff_of_staged | grep -E '^\+' | grep -oE "$id_pattern" | looks_like_real_id | sort -u | head -5) || true
if [ -n "$id_hits" ]; then
  report "looks like a real Slack channel/user/team ID (use C00000001 / U00000001):"
  echo "$id_hits" | sed 's/^/      /' >&2
fi

# --- 4. Fixture filenames -------------------------------------------------
# Recorded fixtures carry real IDs in their FILENAME as well as their body;
# the anonymizer scrubs both, but a hand-copied file would slip through.
name_hits=$(echo "$staged" | grep -E 'tests/fixtures/mock/' | looks_like_real_id | sort -u | head -5) || true
if [ -n "$name_hits" ]; then
  report "fixture FILENAME carries a real ID — re-run 'bun run anonymize':"
  echo "$name_hits" | sed 's/^/      /' >&2
fi

if [ "$fail" -ne 0 ]; then
  echo >&2
  echo "  Replace it with a placeholder (alice/bob, acme.slack.com, C00000001)." >&2
  echo "  If this is a genuine false positive: git commit --no-verify" >&2
  exit 1
fi

exit 0
